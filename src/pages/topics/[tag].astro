---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../site.config';
import { getAllTopics, slugifyTag } from '../../utils/content';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const topics = getAllTopics(notes);
  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: {
      topic,
      topics,
      notes: notes
        .filter((entry) => entry.data.tags.some((tag) => slugifyTag(tag) === topic.slug))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()),
    },
  }));
}

const { topic, topics, notes } = Astro.props;
---

<BaseLayout title={`#${topic.name} | ${siteConfig.name}`} description={`浏览「${topic.name}」主题下的文章与经验总结。`}>
  <header class="container-narrow page-head">
    <a class="back-link" href={withBase('/topics')}><Icon name="arrow-left" size={15} />全部专题</a>
    <h1 class="page-title"><span class="hash" aria-hidden="true">#</span>{topic.name}</h1>
    <p class="page-desc">这个主题下共有 {topic.count} 篇文章。</p>
  </header>

  <section class="container-narrow section-tight">
    <div class="note-list">{notes.map((note) => <NoteCard note={note} fullDate />)}</div>

    <nav class="other-topics" aria-label="其他专题">
      <p class="footer-label">其他专题</p>
      <ul class="topic-chips">
        {
          topics
            .filter((item) => item.slug !== topic.slug)
            .map((item) => <li><a class="topic-chip" href={withBase(`/topics/${item.slug}`)}>#{item.name}<span>{item.count}</span></a></li>)
        }
      </ul>
    </nav>
  </section>
</BaseLayout>
