---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { principles, siteConfig, techHighlights } from '../site.config';
import { withBase } from '../utils/url';
import homeData from '../content/site/home.json';

const facts = [
  { label: '学校与专业', value: '中国地质大学（北京）· 应用统计硕士' },
  { label: '预计毕业', value: '2028 年' },
  { label: '求职方向', value: 'AI 应用开发 / 大模型开发 / 数据工程' },
  { label: '所在地区', value: siteConfig.location },
  { label: '当前状态', value: siteConfig.availability },
];

const directions = [
  { label: '个人 Agent 与 RAG', title: '让对话有上下文，让讨论有出处。', body: '在 WeiJin 中实践文学检索、人格版本、记忆治理与本地部署。', href: '/projects/weijin' },
  { label: '面试学习工具', title: '从零散素材，到能持续复习的题库。', body: 'Gleaner 负责发现与打包，Interview Bank 负责整理与研究，在线版承接日常阅读和练习。', href: '/projects/interview-bank' },
  { label: '研究与统计自动化', title: '保留研究过程中的证据与确认。', body: '以 MedStatForge、医学分析编排与 SPSS Skills，探索从数据、方案到统计交付的可追溯流程。', href: '/projects/medstatforge' },
];
---

<BaseLayout title={`关于 | ${siteConfig.name}`} description="EXIST-D，中国地质大学（北京）应用统计硕士在读，关注 AI Agent、RAG、数据工程与研究流程自动化。">
  <header class="container-narrow page-head">
    <p class="eyebrow">About</p>
    <h1 class="page-title">你好，我是{siteConfig.name}。</h1>
    <p class="page-desc lg">{homeData.aboutSection.summary}</p>
    <div class="hero-actions">
      <a class="button primary" href={`mailto:${siteConfig.email}`}><Icon name="mail" size={15} />写邮件给我</a>
      <a class="button" href={siteConfig.github} target="_blank" rel="noreferrer"><Icon name="github" size={15} />GitHub</a>
    </div>
  </header>

  <div class="container-narrow about-sections">
    <section aria-labelledby="facts-title">
      <h2 id="facts-title" class="section-title">基本信息</h2>
      <dl class="fact-table">
        {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="direction-title">
      <h2 id="direction-title" class="section-title">我在做的方向</h2>
      <div class="direction-list">
        {
          directions.map((item, index) => (
            <article class="direction-item">
              <span class="now-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="eyebrow-sm">{item.label}</p>
                <h3><a class="stretched-link" href={withBase(item.href)}>{item.title}</a></h3>
                <p>{item.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="tech-stack" aria-labelledby="stack-title">
      <h2 id="stack-title" class="section-title">技术栈</h2>
      <dl class="stack-list">
        {techHighlights.map((item) => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="principle-title">
      <h2 id="principle-title" class="section-title">写作与做事的原则</h2>
      <ul class="principle-list">{principles.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="contact-card" aria-labelledby="contact-title">
      <h2 id="contact-title">聊聊项目与机会</h2>
      <p>欢迎交流 AI 应用、Agent 开发、研究自动化，以及相关实习与工作机会。</p>
      <a class="contact-email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </section>
  </div>
</BaseLayout>
