---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { siteConfig } from '../../site.config';
import { getAllTopics } from '../../utils/content';
import { yearOf } from '../../utils/format';
import { withBase } from '../../utils/url';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const topics = getAllTopics(notes);
const years = Array.from(new Set(notes.map((note) => yearOf(note.data.publishedAt)))).map((year) => ({
  year,
  notes: notes.filter((note) => yearOf(note.data.publishedAt) === year),
}));
---

<BaseLayout title={`文章 | ${siteConfig.name}`} description="公开记录项目实践、问题拆解与技术复盘。">
  <header class="container-narrow page-head">
    <p class="eyebrow">Writing</p>
    <h1 class="page-title">文章</h1>
    <p class="page-desc">记录项目里的思考、技术选择和学习过程。共 {notes.length} 篇，按时间倒序排列。</p>
    <ul class="topic-chips" aria-label="按专题浏览">
      {topics.map((topic) => <li><a class="topic-chip" href={withBase(`/topics/${topic.slug}`)}>#{topic.name}<span>{topic.count}</span></a></li>)}
    </ul>
  </header>

  <section class="container-narrow section-tight">
    {
      years.map((group) => (
        <section class="year-group" aria-labelledby={`year-${group.year}`}>
          <h2 id={`year-${group.year}`} class="year-title">{group.year}</h2>
          <div class="note-list">{group.notes.map((note) => <NoteCard note={note} />)}</div>
        </section>
      ))
    }
  </section>
</BaseLayout>
