---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../site.config';
import { getRelatedNotes, slugifyTag } from '../../utils/content';
import { formatDate } from '../../utils/format';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );
  return notes.map((entry, index) => ({
    params: { slug: entry.slug },
    props: { entry, newer: notes[index - 1], older: notes[index + 1], related: getRelatedNotes(notes, entry) },
  }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
  newer?: CollectionEntry<'notes'>;
  older?: CollectionEntry<'notes'>;
  related: Array<CollectionEntry<'notes'>>;
}

const { entry, newer, older, related } = Astro.props;
const { data } = entry;
const { Content, headings } = await entry.render();
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const url = new URL(withBase(`/notes/${entry.slug}`), Astro.site ?? siteConfig.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: siteConfig.name },
  mainEntityOfPage: url,
  keywords: data.tags.join(', '),
};
const relatedOnly = related.filter((note) => note.slug !== newer?.slug && note.slug !== older?.slug);
---

<BaseLayout title={`${data.title} | ${siteConfig.name}`} description={data.description} structuredData={structuredData} progress headerTitle={data.title} headerKicker="文章">
  <div class:list={['container', 'article-layout', toc.length > 1 && 'has-toc']}>
    <article class="detail">
      <header class="detail-head">
        <a class="back-link" href={withBase('/notes')}><Icon name="arrow-left" size={15} />全部文章</a>
        <ul class="tag-row" aria-label="文章标签">
          {data.tags.map((tag) => <li><a href={withBase(`/topics/${slugifyTag(tag)}`)}>#{tag}</a></li>)}
        </ul>
        <h1 class="detail-title">{data.title}</h1>
        <p class="detail-desc">{data.description}</p>
        <p class="detail-meta">
          <span><Icon name="calendar" size={15} /><time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>
          <span><Icon name="clock" size={15} />{data.minutes} 分钟阅读</span>
          {data.updatedAt && <span>更新于 {formatDate(data.updatedAt)}</span>}
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="detail-foot">
        <div class="author-card">
          <img class="author-avatar" src={siteConfig.avatar} alt="" width="52" height="52" loading="lazy" decoding="async" />
          <div>
            <strong>{siteConfig.handle}</strong>
            <p>{siteConfig.intro}</p>
            <div class="author-links">
              <a href={withBase('/about')}>关于我</a>
              <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
              <a href={siteConfig.xiaohongshu} target="_blank" rel="noreferrer">小红书</a>
              <a href={siteConfig.bilibili} target="_blank" rel="noreferrer">哔哩哔哩</a>
            </div>
          </div>
        </div>

        {
          (newer || older) && (
            <nav class="pager" aria-label="上一篇与下一篇">
              {older ? (
                <a class="pager-link" href={withBase(`/notes/${older.slug}`)}>
                  <span>上一篇</span>
                  <strong>{older.data.title}</strong>
                </a>
              ) : <span />}
              {newer && (
                <a class="pager-link is-next" href={withBase(`/notes/${newer.slug}`)}>
                  <span>下一篇</span>
                  <strong>{newer.data.title}</strong>
                </a>
              )}
            </nav>
          )
        }

        {
          relatedOnly.length > 0 && (
            <section class="related" aria-labelledby="related-title">
              <h2 id="related-title" class="related-title">相关文章</h2>
              <ul>
                {relatedOnly.map((note) => (
                  <li><a href={withBase(`/notes/${note.slug}`)}>{note.data.title}</a></li>
                ))}
              </ul>
            </section>
          )
        }
      </footer>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="文章目录">
          <p class="toc-label">目录</p>
          <ol>
            {toc.map((heading) => (
              <li class:list={{ 'is-sub': heading.depth === 3 }}>
                <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
              </li>
            ))}
          </ol>
          <a class="toc-top" href="#main-content"><Icon name="arrow-up" size={14} />回到顶部</a>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  // Highlight the table-of-contents entry for the section being read.
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')).map((link) => [link.dataset.tocLink, link]),
  );
  if (links.size) {
    const headings = Array.from(document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')).filter((h) => links.has(h.id));
    const update = () => {
      let current = headings[0]?.id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top < 140) current = heading.id;
      }
      links.forEach((link, id) => link.toggleAttribute('aria-current', id === current));
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
