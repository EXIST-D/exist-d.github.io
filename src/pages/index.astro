---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../site.config';
import { formatIsoDate } from '../utils/format';
import { withBase } from '../utils/url';
import homeData from '../content/site/home.json';
import '../styles/home.css';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = homeData.featuredProjects
  .map((slug) => projects.find((entry) => entry.slug === slug))
  .filter((entry): entry is (typeof projects)[number] => Boolean(entry));
const others = projects.filter((entry) => !homeData.featuredProjects.includes(entry.slug));
const { hero, nowSection } = homeData;

// Hero title is split into characters so each one can rise in turn.
const STEP = 50; // ms between characters
type Segment = { chars: string[]; kind: 'text' | 'name' | 'code' };
const line1: Segment[] = [
  { chars: Array.from(hero.greeting), kind: 'text' },
  { chars: Array.from(siteConfig.handle), kind: 'name' },
];
const line2: Segment[] = hero.role.map((part) => ({ chars: Array.from(part.text), kind: part.code ? 'code' : 'text' }));
let counter = 0;
const withDelay = (segments: Segment[]) =>
  segments.map((segment) => ({ ...segment, chars: segment.chars.map((char) => ({ char, delay: counter++ * STEP })) }));
const titleLine1 = withDelay(line1);
const waveDelay = counter++ * STEP;
const titleLine2 = withDelay(line2);
const afterTitle = counter * STEP + 300;

const socials = [
  { label: 'GitHub', href: siteConfig.github, icon: 'github', color: '#181717', external: true },
  { label: '邮箱', href: `mailto:${siteConfig.email}`, icon: 'mail', color: '#D44638' },
  { label: 'RSS', href: withBase('/rss.xml'), icon: 'rss', color: '#F08A00' },
  { label: '在线刷题', href: 'https://exist.qd.je/', icon: 'book', color: '#2f7a63', external: true },
  { label: '像素校园', href: 'https://huepixel.top/pixel/', icon: 'gamepad', color: '#5b6cf0', external: true },
];

const windsock = [
  { title: '读读文章', href: withBase('/notes'), icon: 'pen' },
  { title: '看看我做些啥', href: withBase('/projects'), icon: 'flask' },
  { title: '按专题逛逛', href: withBase('/topics'), icon: 'hash' },
  { title: '认识一下我', href: withBase('/about'), icon: 'user' },
  { title: '刷一道面试题', href: 'https://exist.qd.je/', icon: 'book', external: true },
  { title: '去像素校园散步', href: 'https://huepixel.top/pixel/', icon: 'gamepad', external: true },
];
---

<BaseLayout>
  <!-- ========== Screen 1: hero ========== -->
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero-inner">
      <div class="hero-text">
        <h1 id="hero-title" class="hero-heading">
          <span class="hero-line">
            {
              titleLine1.map((segment) => (
                <span class:list={['hero-seg', `is-${segment.kind}`]}>
                  {segment.chars.map(({ char, delay }) => (
                    <span class="char" style={`--d:${delay}ms`}>{char === ' ' ? ' ' : char}</span>
                  ))}
                </span>
              ))
            }
            <span class="char hero-wave" style={`--d:${waveDelay}ms`} aria-hidden="true">👋</span>
          </span>
          <span class="hero-line hero-line-2">
            {
              titleLine2.map((segment) => (
                <span class:list={['hero-seg', `is-${segment.kind}`]}>
                  {segment.chars.map(({ char, delay }) => (
                    <span class="char" style={`--d:${delay}ms`}>{char === ' ' ? ' ' : char}</span>
                  ))}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="hero-desc rise" style={`--d:${afterTitle}ms`}>{hero.description}</p>

        <ul class="hero-socials" aria-label="联系方式与在线项目">
          {
            socials.map((item, index) => (
              <li class="rise" style={`--d:${afterTitle + 200 + index * 90}ms`}>
                <a
                  class="social-bubble"
                  href={item.href}
                  style={`--c:${item.color}`}
                  aria-label={item.label}
                  data-tip={item.label}
                  {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  <Icon name={item.icon} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-avatar rise" style="--d:150ms">
        <img src={siteConfig.avatar} alt={`${siteConfig.handle} 的头像`} width="300" height="300" decoding="async" fetchpriority="high" />
      </div>
    </div>

    <div class="hero-foot rise" style={`--d:${afterTitle + 700}ms`}>
      <small class="hero-quote">{hero.quote}</small>
      <a class="hero-scroll" href="#home-activity" aria-label="向下滚动查看更多"><Icon name="chevron-down" size={24} /></a>
    </div>
  </section>

  <!-- ========== Screen 2: recent activity ========== -->
  <section class="home-screen" id="home-activity" aria-label="最近动态">
    <div class="two-col">
      <div class="col">
        <header class="screen-head">
          <h2>最近写下的文字</h2>
          <p>项目里的思考、技术选择和一些记录</p>
        </header>
        <ol class="post-list">
          {
            notes.slice(0, 5).map((note, index) => (
              <li class="post-item" style={`--i:${index}`}>
                <a class="post-link" href={withBase(`/notes/${note.slug}`)}>
                  <span class="post-title">{note.data.title}</span>
                  <span class="post-meta">
                    <time datetime={note.data.publishedAt.toISOString()}>{formatIsoDate(note.data.publishedAt)}</time>
                    <span>{note.data.tags[0]}</span>
                    <span>{note.data.minutes} 分钟</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class="more-link" href={withBase('/notes')}>还有更多 <Icon name="arrow" size={15} /></a>
      </div>

      <div class="col">
        <header class="screen-head">
          <h2>{nowSection.title}</h2>
          <p>更新于 {nowSection.updatedAt.replaceAll('-', '.')}</p>
        </header>
        <ol class="now-timeline">
          {
            nowSection.items.map((item) => (
              <li>
                <a href={withBase(item.href)}>
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ========== Screen 3: projects ========== -->
  <section class="home-screen" aria-labelledby="projects-title">
    <header class="screen-head center">
      <h2 id="projects-title">看看我做了些什么</h2>
      <p>多人网页游戏、个人 Agent、学习工具与研究自动化</p>
    </header>
    <div class="container">
      <div class="project-grid">{featured.map((project) => <ProjectCard project={project} />)}</div>
      {
        others.length > 0 && (
          <p class="more-line center">
            <span>还有</span>
            {others.map((project) => (
              <a href={withBase(`/projects/${project.slug}`)}>{project.data.title}</a>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <!-- ========== Screen 4: windsock ========== -->
  <section class="home-screen windsock" aria-labelledby="windsock-title">
    <header class="screen-head center">
      <h2 id="windsock-title">风向标</h2>
      <p>去到别处看看？</p>
    </header>
    <ul class="windsock-list">
      {
        windsock.map((item, index) => (
          <li>
            <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}>
              <Icon name={item.icon} size={22} />
              <span>{item.title}</span>
            </a>
            {index < windsock.length - 1 && <span class="windsock-dot" aria-hidden="true">·</span>}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
