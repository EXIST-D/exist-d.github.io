---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../utils/url';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const notes = await getCollection('notes', ({ data }) => !data.draft);
const entries = [
  ...projects
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => ({ title: entry.data.title, description: entry.data.description, tags: entry.data.stack, type: '项目', url: withBase(`/projects/${entry.slug}`) })),
  ...notes
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .map((entry) => ({ title: entry.data.title, description: entry.data.description, tags: entry.data.tags, type: '文章', url: withBase(`/notes/${entry.slug}`) })),
];
---

<dialog id="site-search" class="search-dialog" aria-label="搜索项目与文章" data-entries={JSON.stringify(entries)}>
  <div class="search-panel">
  <div class="search-field">
    <Icon name="search" size={18} />
    <input type="search" placeholder="搜索项目、文章或技术栈…" aria-label="搜索关键词" autocomplete="off" />
    <button type="button" class="search-esc" data-close-search aria-label="关闭搜索">Esc</button>
  </div>
  <p class="search-summary" role="status" aria-live="polite">输入关键词，查找公开项目与文章。</p>
  <ul class="search-results"></ul>
  <div class="search-hint"><span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>Enter</kbd> 打开</span><span><kbd>Esc</kbd> 关闭</span></div>
  </div>
</dialog>

<script>
  import { searchEntries } from '../utils/search.mjs';

  const dialog = document.querySelector<HTMLDialogElement>('#site-search');
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('input')!;
    const results = dialog.querySelector<HTMLUListElement>('.search-results')!;
    const summary = dialog.querySelector<HTMLElement>('.search-summary')!;
    const entries = JSON.parse(dialog.dataset.entries ?? '[]');
    const idle = '输入关键词，查找公开项目与文章。';
    let active = -1;

    const links = () => Array.from(results.querySelectorAll<HTMLAnchorElement>('a'));
    const setActive = (index: number) => {
      const items = links();
      if (!items.length) return;
      active = (index + items.length) % items.length;
      items.forEach((link, i) => link.toggleAttribute('data-active', i === active));
      items[active].scrollIntoView({ block: 'nearest' });
    };

    const render = () => {
      const query = input.value;
      const matches = searchEntries(entries, query);
      results.replaceChildren();
      active = -1;
      summary.textContent = !query.trim() ? idle : matches.length ? `找到 ${matches.length} 条结果` : '没有找到相关内容，换个关键词试试。';
      for (const entry of matches) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = entry.url;
        const type = document.createElement('span');
        type.className = 'search-type';
        type.textContent = entry.type;
        const body = document.createElement('span');
        body.className = 'search-body';
        const title = document.createElement('strong');
        title.textContent = entry.title;
        const description = document.createElement('span');
        description.textContent = entry.description;
        body.append(title, description);
        link.append(type, body);
        item.append(link);
        results.append(item);
      }
      if (matches.length) setActive(0);
    };

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.select();
    };

    document.querySelectorAll('[data-open-search]').forEach((el) => el.addEventListener('click', open));
    dialog.querySelector('[data-close-search]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      } else if (event.key === '/' && !dialog.open && !(event.target as HTMLElement).closest('input, textarea, [contenteditable]')) {
        event.preventDefault();
        open();
      }
    });
    input.addEventListener('input', render);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter' && active >= 0) {
        event.preventDefault();
        links()[active]?.click();
      }
    });
  }
</script>
