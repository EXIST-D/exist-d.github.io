---
import type { CollectionEntry } from 'astro:content';
import { formatIsoDate, formatShortDate } from '../utils/format';
import { withBase } from '../utils/url';

interface Props {
  note: CollectionEntry<'notes'>;
  /** Show the description under the title. */
  excerpt?: boolean;
  /** Include the year in the date column (lists not grouped by year). */
  fullDate?: boolean;
}
const { note, excerpt = true, fullDate = false } = Astro.props;
---

<article class:list={['note-row', fullDate && 'has-full-date']}>
  <time class="note-date" datetime={note.data.publishedAt.toISOString()}>{fullDate ? formatIsoDate(note.data.publishedAt) : formatShortDate(note.data.publishedAt)}</time>
  <div class="note-main">
    <h3 class="note-title"><a class="stretched-link" href={withBase(`/notes/${note.slug}`)}>{note.data.title}</a></h3>
    {excerpt && <p class="note-excerpt">{note.data.description}</p>}
    <p class="note-meta">
      <span>{note.data.minutes} 分钟阅读</span>
      {note.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
    </p>
  </div>
</article>
