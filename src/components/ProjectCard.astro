---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../site.config';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const href = withBase(`/projects/${project.slug}`);
---

<article class="project-card" data-category={data.category} data-project-category={data.category}>
  <div class="project-body">
    <div class="project-meta-line">
      <span class="project-category">{categoryLabel(data.category)}</span>
      <span class="project-status"><span class="status-dot" aria-hidden="true"></span>{data.status}</span>
    </div>
    <h3 class="project-title"><a class="stretched-link" href={href}>{data.title}</a></h3>
    <p class="project-description">{data.description}</p>
    <ul class="tag-list" aria-label="技术栈">
      {data.stack.slice(0, 5).map((item) => <li class="tag">{item}</li>)}
    </ul>
    <div class="project-links">
      <span class="project-more">查看案例 <Icon name="arrow" size={15} /></span>
      {data.demo && <a class="chip-link" href={data.demo} target="_blank" rel="noreferrer"><Icon name="play" size={13} />在线体验</a>}
      {data.repo && <a class="chip-link" href={data.repo} target="_blank" rel="noreferrer" aria-label={`${data.title} 的 GitHub 仓库`}><Icon name="github" size={13} />源码</a>}
    </div>
  </div>
</article>
